# Copy to .env for local overrides (optional).
# Defaults in middleware/config.js are enough for foundation work.

PORT=4303
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Optional:
# SESSION_SECRET=
# BRIDGE_URL=
# BRIDGE_SECRET=
# STORE_ADAPTER=memory
# STORE_ADAPTER=sheets          # fixture/bridge reads; writes still off by default
# USE_LIVE_BRIDGE=false
# APP_MODE=staging
# STAGING_WRITES=false
# WRITER_OF_RECORD=ts2           # set ts3 only for supervised Staging writes
# RETRY_ATTEMPTS=3
# RETRY_DELAY_MS=50
# QUEUE_MODE=off
#
# Dual-track: never point tooling at editing ts-2.
# Same live Sheets when bridge is on; public traffic stays on ts-2 until go-live.
