# Copy to .env for local overrides (optional).
# Defaults in middleware/config.js are enough for foundation work.

PORT=4303
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Optional:
# SESSION_SECRET=
# STORE_ADAPTER=memory
# STORE_ADAPTER=sheets          # fixture, or live after USE_LIVE_BRIDGE hydrate
# USE_LIVE_BRIDGE=false         # true + BRIDGE_* = live Master read (Slice 13+)
# BRIDGE_URL=                   # Apps Script web-app /exec URL
# BRIDGE_SECRET=                # must match Script Property BRIDGE_SECRET
# SHEETS_FIXTURE_PATH=          # optional offline fixture override
# APP_MODE=staging
# STAGING_WRITES=false          # keep false for live-read-only
# WRITER_OF_RECORD=ts2           # set ts3 only for supervised Staging writes
#
# Live project vocabulary (Inject):
#   1. Redeploy apps-script/bridge.gs (Projects / admin tab schema)
#   2. ./run-live-read.sh   OR set USE_LIVE_BRIDGE=true + BRIDGE_* above
#   3. Inject tab → Refresh from master  (POST /api/bridge/refresh)
#
# Dual-track: never point tooling at editing ts-2.
# Same live Sheets when bridge is on; public traffic stays on ts-2 until go-live.
