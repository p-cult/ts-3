# Live Sheets one-box — same wiring as production Render, but UI+API same host.
# Requires working Apps Script bridge. Do NOT dual-write with another ts-3/ts-2.
#
# Copy to deploy/one-box/.env, fill secrets, then:
#   docker compose up --build
# Or: ./scripts/run-one-box.sh --live

NODE_ENV=production
APP_MODE=production
HOST=0.0.0.0
PORT=4303
LOG_LEVEL=info

# Strong unique secret (required in production). Never commit the real value.
SESSION_SECRET=replace-with-long-random-string

STORE_ADAPTER=sheets
USE_LIVE_BRIDGE=true
BRIDGE_PROTOCOL=thin
WRITER_OF_RECORD=ts3
STAGING_WRITES=false
QUEUE_MODE=off
OUTBOX_AWAIT_BIRTH=true

# From Apps Script deploy + Script Properties (must match exactly).
BRIDGE_URL=https://script.google.com/macros/s/REPLACE/exec
BRIDGE_SECRET=replace-me
MASTER_ID=replace-with-master-spreadsheet-id

# Same-origin — leave empty (do not copy Pages CORS_ORIGIN here).
CORS_ORIGIN=

RATE_WINDOW_MS=60000
RATE_MAX_LOGINS=20
RATE_MAX_WRITES=120
