# Offline / demo one-box (no Google). Fixture logins work.
# Copy to deploy/one-box/.env then: docker compose up --build
# Or: ./scripts/run-one-box.sh --memory

NODE_ENV=production
APP_MODE=staging
HOST=0.0.0.0
PORT=4303
LOG_LEVEL=info

SESSION_SECRET=one-box-demo-change-me-not-for-live

STORE_ADAPTER=memory
USE_LIVE_BRIDGE=false
WRITER_OF_RECORD=ts2
STAGING_WRITES=false
QUEUE_MODE=off

# Leave empty — UI and API share this host.
CORS_ORIGIN=
