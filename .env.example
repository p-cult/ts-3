# Copy to .env for local overrides (optional).
# Defaults in middleware/config.js are enough for foundation work.

PORT=4303
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Optional:
# SESSION_SECRET=
# STORE_ADAPTER=memory
# STORE_ADAPTER=sheets          # fixture, or live after USE_LIVE_BRIDGE hydrate
# USE_LIVE_BRIDGE=false         # true + BRIDGE_* = live Master read (Slice 13+)
# BRIDGE_URL=                   # Apps Script web-app /exec URL
# BRIDGE_SECRET=                # must match Script Property BRIDGE_SECRET
# SHEETS_FIXTURE_PATH=          # optional offline fixture override
# APP_MODE=staging
# STAGING_WRITES=false          # staging supervised latch only
# WRITER_OF_RECORD=ts2           # ts2 until cutover; ts3 = sole writer
# BRIDGE_PROTOCOL=thin           # live Apps Script (ts-2 thin bridge)
# MASTER_ID=                     # same live Master spreadsheet id
#
# Live read rehearsal:  ./run-live-read.sh
# Sole writer (after ts-2 stopped): ./run-sole.sh
#   → APP_MODE=production WRITER_OF_RECORD=ts3 USE_LIVE_BRIDGE=true
#
# Dual-track: never edit ts-2. Same Sheets; after switch only ts-3 reads/writes.
