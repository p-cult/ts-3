# Copy to .env for local overrides (optional).
# Defaults in middleware/config.js are enough for foundation work.

PORT=4303
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Later slices (do not use yet):
# SESSION_SECRET=
# BRIDGE_URL=
# BRIDGE_SECRET=
# STORE_ADAPTER=memory
# USE_LIVE_BRIDGE=false
# APP_MODE=staging
# STAGING_WRITES=false
# RETRY_ATTEMPTS=3
# RETRY_DELAY_MS=50
# QUEUE_MODE=off
